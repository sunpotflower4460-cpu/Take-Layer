# Why: resolving vitest@4.x from scratch (npm install without a lockfile) crashes npm's arborist with
#   "Cannot read properties of null (reading 'edgesOut')"
# (bisected: vitest 4.1.11 alone triggers it; it declares many OPTIONAL peer dependencies). With
# legacy-peer-deps the resolver skips peer-dependency auto-install and works. Reproducible installs use the
# committed package-lock.json via `npm ci` (CI does). Remove this file once npm fixes the resolver.
legacy-peer-deps=true
